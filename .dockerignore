!THIRD-PARTY-LICENSES.md

# Runtime configuration and databases belong on the deployment host.
**/.env
**/.env.*
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
/data
/logs
/upload
**/*.log

# Local payment credentials and test artifacts are not build inputs.
/*.pem
/*.key
/*.p12
/*.pfx
/*私钥*.txt
/*公钥*.txt
/alipayPublicKey*.txt
/qa-token*.txt
/qa-test*.ps1
/.shot-*.png
/.local-tests
/.playwright-mcp
/.codebuddy

# Local tool caches and binaries; dependencies are installed in build stages.
**/node_modules
/bin
/build
/new-api
/new-api.exe
/one-api
/__debug_bin*
/.cache
/.gomodcache
/.gocache-temp
/.gopath
/.test
/go.work
/go.work.sum
/electron/dist
